{
  "expo": {
    "name": "Modèles de coiffure",
    "slug": "modeles-coiffure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Modèles de coiffure",
      "shortName": "Coiffures",
      "lang": "fr",
      "themeColor": "#7A3E1D",
      "backgroundColor": "#FBF6F0",
      "display": "standalone",
      "description": "Créer des modèles de coiffures : tresses, flat twists, barrel twists, vanilles, fulani.",
      "orientation": "portrait"
    },
    "scheme": "modelescoiffure",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "L’application a besoin de tes photos pour combiner des coiffures."
        }
      ]
    ]
  }
}
